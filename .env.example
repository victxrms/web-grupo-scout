# Configuración de Firebase. Lo más fácil: ejecuta `npm run configurar`,
# que crea el archivo .env por ti. Si prefieres hacerlo a mano, copia este
# archivo como .env y rellénalo con los datos de Firebase Console →
# Configuración del proyecto → Tus apps → App web.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Correo de Google de la primera administradora (la misma que en firestore.rules).
VITE_ADMIN_INICIAL=

# Dirección pública de la web, sin barra final (para buscadores y redes).
VITE_URL_WEB=

# Opcional: clave de reCAPTCHA v3 para App Check (protección extra).
VITE_RECAPTCHA_SITE_KEY=
